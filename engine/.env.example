# Copy to engine/.env and fill in. engine/.env is git-ignored; never commit a real key.
# Optional: enables AI-assisted import for unusual layouts and the AI rewording / polish features.
# Everything else works without it. scripts/dev.ps1 loads this file into the engine.
# AI is Groq only (free models). No Anthropic/Claude key is used by this project.
GROQ_API_KEY=

# First model (strict JSON-schema output) and free fallback models, tried in order when a model is
# rate limited, overloaded or answers badly. Each Groq model has its own free per-minute budget.
RESUME_ENGINE_MODEL=openai/gpt-oss-120b
RESUME_ENGINE_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Set to "off" to disable AI features even when a key is present.
RESUME_ENGINE_LLM=
